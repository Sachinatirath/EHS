# Copy this file to .env and adjust values for your environment.

# SQLite by default. For Postgres use e.g.
# postgresql://user:password@localhost:5432/fastaid
DATABASE_URL=sqlite:///./fastaid.db

# Secret used to sign JWT access tokens. Generate your own for anything
# beyond local development, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=c957eaf35c85aa226b907f4f9f8a618b489a8e6b3f6383bedf1ca7f340401ebd

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=168

# Comma-separated list of allowed origins, or * for any (fine for local dev
# since the Expo app is not served from a browser origin).
CORS_ORIGINS=*

UPLOAD_DIR=uploads
