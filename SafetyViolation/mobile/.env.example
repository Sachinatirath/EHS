# Copy this file to .env and set it to your computer's LAN IP address
# (not localhost/127.0.0.1 -- your phone is a separate device on the network
# and cannot reach your computer's "localhost").
#
# Find your LAN IP with:
#   Linux/Mac: hostname -I   (or ifconfig)
#   Windows:   ipconfig
#
# Then run the backend with: uvicorn app.main:app --host 0.0.0.0 --port 8000
# so it listens on that IP too.
EXPO_PUBLIC_API_URL=http://192.168.1.141:8000
